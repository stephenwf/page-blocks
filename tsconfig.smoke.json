{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "page-blocks": ["./dist/core/index.d.ts"],
      "page-blocks/core": ["./dist/core/index.d.ts"],
      "page-blocks/client": ["./dist/client/index.d.ts"],
      "page-blocks/node": ["./dist/node/index.d.ts"],
      "page-blocks/next": ["./dist/next/index.d.ts"],
      "page-blocks/file-system": ["./dist/file-system/index.d.ts"],
      "page-blocks/screenshots": ["./dist/screenshots/index.d.ts"],
      "page-blocks/react-client": ["./dist/react-client/index.d.ts"],
      "page-blocks/react": ["./dist/react/index.d.ts"],
      "page-blocks/react-editor": ["./dist/react-editor/index.d.ts"],
      "page-blocks/vite": ["./dist/vite/index.d.mts"],
      "page-blocks/vite/server": ["./dist/vite/server.d.mts"],
      "page-blocks/web-components": ["./dist/web-components/index.d.ts"],
      "page-blocks/react/style.css": ["./dist/style.d.ts"],
      "page-blocks/react-editor/style.css": ["./dist/style.d.ts"],
      "page-blocks/web-components/style.css": ["./dist/style.d.ts"],
      "page-blocks/react/dist/index.css": ["./dist/style.d.ts"],
      "page-blocks/react-editor/dist/index.css": ["./dist/style.d.ts"],
      "page-blocks/web-components/dist/index.css": ["./dist/style.d.ts"]
    },
    "rootDir": "."
  },
  "include": [
    "smoke/**/*.ts",
    "smoke/**/*.mts"
  ]
}
