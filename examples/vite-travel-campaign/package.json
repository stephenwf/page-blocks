{
  "name": "page-blocks-example-vite-travel-campaign",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter page-blocks build && vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "pnpm --filter page-blocks build && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "typecheck": "pnpm --filter page-blocks build && tsc -p ./tsconfig.app.json --noEmit && tsc -p ./tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@nanostores/react": "^0.7.1",
    "page-blocks": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.3",
    "uniforms": "^4.0.0-alpha.5",
    "uniforms-bridge-zod": "^4.0.0-alpha.5",
    "uniforms-semantic": "^4.0.0-alpha.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.5.2",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.39.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.10"
  }
}
