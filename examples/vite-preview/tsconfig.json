{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2020",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
