{
  "name": "page-blocks-example-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter page-blocks build && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "pnpm --filter page-blocks build && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "pnpm --filter page-blocks build && tsc -p ./tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "@tanstack/react-query": "^5.101.2",
    "page-blocks": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uniforms": "^4.0.0",
    "uniforms-bridge-zod": "^4.0.0",
    "uniforms-semantic": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
